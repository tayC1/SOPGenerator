    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "archiver": "3.1.1",
