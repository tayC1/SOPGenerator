{
  "name": "codex-server",
  "version": "1.0.0",
  "description": "Backend API server for the CODEX Chrome extension",
  "main": "server.js",
  "bin": {
    "codex": "./bin/codex.js"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/pack-extension.js",
    "build:unpacked": "node scripts/build-unpacked.js",
