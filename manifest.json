{
  "manifest_version": 3,
  "name": "SOP Generator",
  "version": "1.0",
  "description": "Record clicks and screenshots to generate SOP documents",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons":{
    "16": "Icons/CODEX - 16PX.png",
    "32": "Icons/CPDEX - 32PX.png",
    "48": "Icons/CODEX - 48PX.png",
  "128": "Icons/CODEX - 128PX.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOP Generator",
    "default_icon": {
      "16": "Icons/CODEX - 16PX.png",
      "32": "Icons/CPDEX - 32PX.png",
      "48": "Icons/CODEX - 48PX.png",
      "128": "Icons/CODEX - 128PX.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": false
    }
  ]
}
